    {
      "name": "gold_dq_issues",
      "displayName": "Data Quality Issues",
      "config": {
        "version": "1.1",
        "source": "SELECT stack(\n  7,\n  'Duplicate bookings', duplicate_rows,\n  'Invalid check-out dates', invalid_date_rows,\n  'Missing city', missing_city_rows,\n  'Negative room rate', negative_rate_rows,\n  'Missing booking channel', missing_channel_rows,\n  'Missing total amount', missing_amount_rows,\n  'Missing nights', missing_nights_rows\n) AS (issue, issue_count)\nFROM hospitality_catalog.hospitality_catalog_bookings.gold_data_quality\n",
        "dimensions": [
          {
            "name": "issue",
            "expr": "source.issue"
          }
        ],
        "measures": [
          {
            "name": "issue_count",
            "expr": "SUM(source.issue_count)",
            "comment": "Number of source rows affected by each data quality issue type.",
            "displayName": "Rows Affected"
          }
        ]
      }
    }
