            "displayName": "Count"
          }
        ]
      }
    },
    {
      "name": "2d7e8cd8",
      "displayName": "gold_data_quality",
      "config": {
        "version": "1.1",
        "source": "hospitality_catalog.hospitality_catalog_bookings.gold_data_quality",
        "dimensions": [
          {
            "expr": "source.*"
          }
        ],
        "measures": [
          {
            "name": "count",
            "expr": "COUNT(*)",
            "comment": "Represents the total number of rows in the dataset. Use this measure to count all rows.",
            "displayName": "Count"
          },
          {
            "name": "reconciliation_gap",
            "expr": "MAX(source.bronze_rows) - MAX(source.duplicate_rows) - MAX(source.clean_rows) - MAX(source.rejected_rows)",
            "comment": "0 when bronze rows minus duplicates reconcile with clean plus rejected rows.",
            "displayName": "Reconciliation Gap"
          }
        ]
      }
    },
    {
      "name": "17348a8e",
      "displayName": "gold_hotel_summary",
      "config": {
        "version": "1.1",
        "source": "hospitality_catalog.hospitality_catalog_bookings.gold_hotel_summary",
        "dimensions": [
          {
            "expr": "source.* EXCEPT (net_revenue, avg_daily_rate)"
          },
          {
            "name": "net_revenue",
            "expr": "source.net_revenue",
            "displayName": "Net Revenue",
            "format": {
              "type": "currency",
              "currencyCode": "INR",
              "decimalPlaces": {
                "type": "max",
                "places": 2.0
              }
            }
          },
          {
            "name": "avg_daily_rate",
            "expr": "source.avg_daily_rate",
            "displayName": "Avg Daily Rate",
            "format": {
              "type": "currency",
              "currencyCode": "INR",
              "decimalPlaces": {
                "type": "max",
                "places": 2.0
              }
            }
          }
        ],
        "measures": [
          {
            "name": "count",
            "expr": "COUNT(*)",
            "comment": "Represents the total number of rows in the dataset. Use this measure to count all rows.",
            "displayName": "Count"
          },
          {
            "displayName": "Net Revenue (Lakh)",
            "format": {
              "type": "number",
              "decimalPlaces": {
                "type": "max",
                "places": 2.0
              }
            },
            "name": "net_revenue_lakh",
            "expr": "SUM(source.net_revenue) / 100000",
            "comment": "Total net revenue in Indian lakh (1 lakh = 1,00,000 rupees)."
          }
        ]
      }
    },
